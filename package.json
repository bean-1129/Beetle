{
  "name": "beetle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Beetle: change the game without stopping the game. Local AI 2D game prototyping studio.",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx apps/server/src/main.ts",
    "build": "npm run build -w apps/web",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "demo:check": "node scripts/demo-check.mjs",
    "benchmark:local": "tsx scripts/measure-2d.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
