# Beetle local configuration. Copy to .env and fill in. Never commit .env.
# Server bind address and port (team LAN). 0.0.0.0 exposes only the web/session app.
BEETLE_HOST=0.0.0.0
BEETLE_PORT=7700
# LAN URL advertised in the join QR (leave blank to auto-detect the first non-loopback IPv4).
BEETLE_PUBLIC_URL=
# Director token (edits, invites). Generated into data/secrets.json on first run if blank.
BEETLE_DIRECTOR_TOKEN=
# Agent token used by the OpenClaw tool plugin to call loopback-only /api/agent endpoints.
BEETLE_AGENT_TOKEN=
# Local model runtime. Loopback only. No cloud fallback exists; a missing model is an error.
OLLAMA_BASE_URL=http://127.0.0.1:11434
BEETLE_MODEL=qwen3.5:4b
# Agent mode: "openclaw" (real OpenClaw tool calls, the submission path) or "direct" (labelled dev harness).
BEETLE_AGENT_MODE=openclaw
# Per-request budgets
BEETLE_REQUEST_DEADLINE_MS=120000
BEETLE_MAX_REPAIR_ATTEMPTS=2
# OpenClaw run budget per request (the agent run inside OpenClaw, separate from the request deadline)
BEETLE_OPENCLAW_TIMEOUT_MS=600000
