# Beetle local configuration. Copy to .env and fill in. Never commit .env.
# Server bind address and port (team LAN). 0.0.0.0 exposes the 2D studio to the LAN.
BEETLE_HOST=0.0.0.0
BEETLE_PORT=7700
# LAN URL advertised in the join QR (leave blank to auto-detect the first non-loopback IPv4).
BEETLE_PUBLIC_URL=
# Director token. Generated into data/secrets.json on first run if blank.
BEETLE_DIRECTOR_TOKEN=
# Local model runtime. Loopback only. No cloud fallback exists; a missing model is an error.
OLLAMA_BASE_URL=http://127.0.0.1:11434
BEETLE_MODEL=qwen3.5:4b
